      "metadata": [
        
        {
                        "name": "4.3.1 Participation rate of adults in education and training",
                      
                        "goal": "Goal 4. Quality education",
                      
                        "target": "4.3 By 2030, ensure equal access for all women and men to affordable and quality technical, vocational and tertiary education, including university",
                      
                        "definition": "The ratio of the number of people participating in education and training in a given age to the total number of population in this age group.",
                      
                        "unit": "percent [%]",
                      
                        "dimensions": "age",
                      
                        "methodology": "The indicator includes training of adults at schools for adults as well as getting and improving general knowledge, professional skills and competences outside school (in the 12 months preceding the survey). The adult learning includes the following forms:  • formal education - defined as institutionally organized learning activities through educational programmes and trainings leading to vocational qualifications • non-formal education - defined as institutionally organized learning activities, however, outside educational programmes and trainings leading to vocational qualifications • informal learning - defined as not institutionally organized intentional learning activities.  Data were compiled on the basis of the results of the international sample survey: Adult Learning Survey (formerly the Adult Education Survey), conducted every 6 years. The survey covers persons aged 18-69 who are members of households in dwellings (according to actual residence). The indicator refers to persons aged 25–64.",
                      
                        "source": "Statistics Poland",
                      
                        "availability": "The average data per year since 2010",
                      
