    {
      "14-1-b": [
        {
          "metadata": [
            
            {
                            "name": "14.1.b Share of marine protected areas",
                          
                            "goal": "Goal 14. Life below water",
                          
                            "priority": "Effective and sustainable exploitation of marine resources for different social and economic purposes, while ensuring conservation of non-renewable resources natural process for the present and future generations; ensurance of coordination of entities' activities and methods of sea exploitation, coherent management of sea and coastal areas, including the Baltic Sea resources",
                          
                            "definition": "Proportion of marine areas under legal protection as a percentage of the total maritime area of a country.",
                          
                            "unit": "percent [%]",
                          
                            "dimensions": "total",
                          
                            "methodology": "The indicator enables the estimation of the proportion of marine protected areas (MPAs) and, over time, the monitoring of trends in their spatial extent.A marine protected area is defined, in accordance with the definition of the International Union for Conservation of Nature (IUCN), as a clearly defined geographical space, which is part of or adjacent to the marine environment, together with its associated flora, fauna and cultural heritage features, which is designated and managed through legal or other effective means, including customary practices. As a result, its biodiversity is subject to a higher level of protection than the surrounding areas.Marine protected areas include sites designated under national legislation as well as those established under the Natura 2000 network.The data required for the calculation of the indicator are provided by Member States, while their consolidation is carried out by the European Environment Agency (EEA) in cooperation with the European Topic Centre on Biological Diversity (ETC/BD).The area of marine waters is reported by Member States on the basis of the provisions of the Marine Strategy Framework Directive (2008/56/EC).",
                          
                            "source": "Eurostat",
                          
                            "availability": "Data are available for selected years since 2012",
                          
                            "notes": "",
                          
                            "data_updated_on": "07-08-2026",
                          
                            "metadata_updated_on": "07-08-2026"
                          }
